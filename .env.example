# Local development values. On cPanel, set these as environment variables in
# "Setup Node.js App" (or in a .env file in the app root) — see README.md.
NODE_ENV=development
DATABASE_URL="mysql://zam_user:change-me@localhost:3306/zam_models"
PORT=4000

# Comma-separated list of allowed frontend origins (no trailing slash)
WEB_ORIGIN=http://localhost:5173

# Runs `prisma migrate deploy` before the API starts. Defaults to true when
# NODE_ENV=production and false otherwise.
# RUN_MIGRATIONS_ON_START=true

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_secure_random_secret
ADMIN_EMAIL=admin@zammodelsandsignatures.com
ADMIN_PASSWORD=change-me-strong-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="Zam Models & Signatures <noreply@zammodelsandsignatures.com>"

PAYSTACK_SECRET_KEY=sk_test_replace_with_your_secret_key
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/verify
AUDITION_REGISTRATION_FEE_KOBO=500000
